/* components/member-sheet/member-sheet.wxss（遮罩/面板/关闭 用 app.wxss sheet-* 共用）
   .ms-panel 仅覆盖 member-sheet 自身的留白与层级（组件 wxss 晚于 app 生效，覆盖 sheet-panel 的 padding/z） */
.ms-panel {
  padding: 32rpx 32rpx 48rpx;
  z-index: 100;
}
.ms-head {
  margin-bottom: 20rpx;
}
.ms-avatar {
  width: 88rpx;
  height: 88rpx;
  font-size: 34rpx;
}
.ms-info {
  margin-left: 20rpx;
}
.ms-school {
  margin-top: 6rpx;
}
.ms-btn {
  margin: 8rpx 0 12rpx;
}
.ms-tip {
  text-align: center;
}
