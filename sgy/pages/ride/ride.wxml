<!--pages/ride/ride.wxml-->
<view class="page">
  <!-- 加载失败 -->
  <view wx:if="{{loaded && errorMsg}}" class="empty">
    <view class="empty-title">加载失败</view>
    <view class="small">{{errorMsg}}</view>
    <button class="btn btn-ghost back-btn" bindtap="goBack">返回</button>
  </view>

  <!-- 正常详情 -->
  <block wx:elif="{{ride}}">
    <!-- 顶部信息 -->
    <view class="card ride-hero">
      <view class="row-between">
        <view class="row">
          <text class="tag {{ride.statusCls}}">{{ride.statusLabel}}</text>
          <text wx:if="{{ride.urgent}}" class="tag tag-urgent">加急</text>
        </view>
        <text class="small link" bindtap="onRule">规则 ›</text>
      </view>
      <view class="route">{{ride.routeLabel}}</view>
      <view class="row-between hero-mid">
        <view class="time">{{ride.dayText}}</view>
        <view class="hero-meta">
          <view>{{ride.departText}}</view>
          <view class="small muted">{{ride.seatText}}</view>
        </view>
      </view>
      <!-- 备注：发起人可修改 -->
      <view wx:if="{{isHost || ride.note}}" class="note-box small">
        <block wx:if="{{editingNote}}">
          <input class="note-input" value="{{noteDraft}}" bindinput="onNoteDraftInput" maxlength="50"
            focus="{{true}}" placeholder="写点集合位置、大概几点到…" />
          <view class="row note-actions">
            <text class="mini-link" catchtap="onSaveNote">保存</text>
            <text class="mini-link muted" catchtap="onCancelNoteEdit">取消</text>
          </view>
        </block>
        <block wx:else>
          <view class="row-between note-view {{isHost ? 'note-editable' : ''}}" bindtap="onTapNote">
            <text class="flex-1 {{ride.note ? '' : 'muted'}}">{{ride.note || '暂无备注'}}</text>
            <text wx:if="{{isHost}}" class="note-edit-btn">{{ride.note ? '修改' : '添加'}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 基本规则（点顶部「规则」展开） -->
    <view wx:if="{{showRules}}" class="card rules-card">
      <view class="rules-title">基本规则</view>
      <view class="rules-row rules-head">
        <text class="t">时间</text>
        <text class="d">说明</text>
      </view>
      <view wx:for="{{rules}}" wx:key="t" class="rules-row">
        <text class="t">{{item.t}}</text>
        <text class="d">{{item.d}}</text>
      </view>
    </view>

    <!-- T−60 人数确认轮询 -->
    <view wx:if="{{meNeedPoll}}" class="card poll-card">
      <view class="poll-title">当前 {{ride.memberCount}} 人，还没到 {{ride.capacity}} 人</view>
      <view class="small muted">接受按当前人数出发、不再招满吗？——点"不了"会免费退出，其余人继续组。</view>
      <view class="row poll-btns">
        <button class="btn btn-primary act-half" bindtap="onPollYes">接受，照走</button>
        <button class="btn btn-danger-ghost act-half" bindtap="onPollNo">不了，我退出</button>
      </view>
    </view>
    <view wx:elif="{{pollAccepted}}" class="poll-tag">
      <text class="tag tag-green">✅ 已确认按当前人数出发</text>
    </view>

    <!-- 成员 -->
    <view class="section">成员（{{ride.memberCount}}/{{ride.capacity}}）</view>
    <view class="card no-margin members">
      <view wx:for="{{ride.members}}" wx:key="openid" class="list-row member-row"
        data-openid="{{item.openid}}" data-name="{{item.name}}" bindtap="openMember">
        <view class="avatar {{item.frame}}">{{item.avatarChar}}</view>
        <view class="flex-1 member-name">
          <text>{{item.name}}</text>
          <text wx:if="{{item.role === 'host'}}" class="tag tag-green host-tag">发起人</text>
          <text wx:if="{{item.checked}}" class="tag tag-gray">已签到</text>
          <text wx:if="{{item.isMe}}" class="tag tag-orange">我</text>
        </view>
      </view>
    </view>

    <!-- 被标记者入队提醒（标记者本人可见；放行但提醒） -->
    <view wx:if="{{isMember && blockedRideText}}" class="card no-margin block-flag">
      <view class="small block-flag-text">⚠️ 这一局有你标记过「不与其乘车」的人：{{blockedRideText}}</view>
      <view class="small muted">若需避开，请自行退出本局</view>
    </view>

    <!-- 操作区 -->
    <view class="card no-margin actions">
      <view wx:if="{{canJoin && !isMember}}" class="join-wrap">
        <button class="btn btn-primary join-center" bindtap="onJoin">加入这一局</button>
      </view>

      <block wx:elif="{{isMember}}">
        <!-- 已结束/已取消：操作灰置，提示点队友头像即可再约 -->
        <view wx:if="{{isDone}}" class="done-tip">
          <view class="done-title">拼车已结束</view>
          <view class="small muted">点击队友头像可 查看资料 · 举报 · 下周再约</view>
        </view>
        <block wx:else>
          <!-- 主动作：我到了（大主按钮独占一行） -->
          <button wx:if="{{!meChecked}}" class="btn btn-primary act-main" bindtap="onCheckin">我到了</button>
          <view wx:else class="act-main act-main-done">✅ 已签到 · 集合吧</view>
          <view wx:if="{{!meChecked}}" class="small muted act-tip">到点请点「我到了」；局结束仍未签到将按爽约自动扣信用分</view>
          <!-- 次要动作：低频小字链接（退出 / 发起人解散，点了再弹确认框） -->
          <view wx:if="{{canLeave || canCancel}}" class="row act-sub">
            <text wx:if="{{canLeave}}" class="act-link" bindtap="onLeave">退出</text>
            <text wx:if="{{canCancel}}" class="act-link" bindtap="onCancel">解散这一局</text>
          </view>
        </block>
      </block>

      <button wx:else class="btn btn-disabled btn-block">{{ride.memberCount >= ride.capacity ? '已满员' : (ride.statusLabel === '招募中' ? '已停止加入' : ride.statusLabel)}}</button>
    </view>

    <!-- 聊天室 -->
    <view class="section">聊天室</view>
    <view class="card no-margin chat">
      <!-- 已加入：跳转去「聊天室」Tab，不再内嵌整块聊天 -->
      <view wx:if="{{isMember}}" class="joined-chat">
        <view class="joined-title">你已在队伍里</view>
        <view class="small muted joined-tip">聊天统一在底部「聊天室」Tab（打开即最新消息）。</view>
        <button class="btn btn-primary join-chat-btn" bindtap="goChatTab">去聊天室 ›</button>
      </view>

      <!-- 未加入：保留提示 -->
      <view wx:else class="locked-chat">
        <view class="locked-title">待加入拼车队聊天室</view>
        <view class="small muted locked-tip">
          加入这一局后才能查看/发送消息。底部「聊天室」Tab 会汇总你所在队伍的聊天，方便随时回来聊。
        </view>
        <button wx:if="{{canJoin}}" class="btn btn-primary join-chat-btn" bindtap="onJoin">加入这一局</button>
      </view>
    </view>

    <!-- 已加入成员才需要转发拉人；未加入的人转发无意义 -->
    <view wx:if="{{isMember}}" class="share-row">
      <button class="btn btn-ghost btn-block" open-type="share">转发到群，还差人</button>
    </view>

    <!-- 平台 AA 提示（常驻入口，点进"如何AA"教程） -->
    <view class="aa-tip" bindtap="openAA">
      <text class="aa-tip-text">💡 平台建议线下 AA，安全妥当；出现逃单、不给钱，平台不负责</text>
      <text class="aa-tip-btn">如何AA ›</text>
    </view>

    <view class="foot-note">只组队不约车：车由你们到点自行拦/叫，车费现场 AA</view>
  </block>

  <view wx:else class="empty">加载中…</view>

  <!-- 成员资料浮层（共用组件：ride 详情与聊天同款） -->
  <member-sheet id="memberSheet" />
</view>
