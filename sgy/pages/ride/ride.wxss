/* pages/ride/ride.wxss */
.block-flag {
  border-left: 8rpx solid #ff9f0a;
}
.block-flag-text {
  color: #ff9f0a;
}
.ride-hero {
  margin-top: 24rpx;
}
.route {
  font-size: 34rpx;
  font-weight: 600;
  margin-top: 20rpx;
}
.hero-mid {
  margin-top: 16rpx;
}
.hero-mid .time {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
}
.hero-meta {
  text-align: right;
  font-size: 28rpx;
}
.note-box {
  margin-top: 16rpx;
  background: #f6f7f9;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  color: #4e545c;
}
.note-input {
  background: #fff;
  border-radius: 8rpx;
  padding: 10rpx 14rpx;
  font-size: 24rpx;
  width: 100%;
  box-sizing: border-box;
}
.note-actions {
  justify-content: flex-end;
  margin-top: 6rpx;
}
.note-edit-btn {
  color: #07a55a;
  padding-left: 20rpx;
}
.note-view {
  align-items: center;
}
.members {
  padding: 8rpx 24rpx;
}
.member-name {
  margin-left: 20rpx;
}
.report-link {
  font-size: 22rpx;
  color: #fa5151;
  padding: 8rpx 0 8rpx 20rpx;
}
.host-tag {
  margin-left: 12rpx;
}
.actions {
  margin-top: 20rpx;
  padding-bottom: 8rpx;
}
.actions .btn-block {
  margin: 0 0 16rpx;
}
.act-half {
  flex: 1;
  margin-right: 16rpx;
  padding: 16rpx 0;
}
.act-half:last-child {
  margin-right: 0;
}
.act-tip {
  margin-top: 16rpx;
  text-align: center;
}
.chat {
  padding: 8rpx 24rpx;
}
.chat-row {
  display: flex;
  padding: 16rpx 0;
}
.chat-avatar {
  width: 60rpx;
  height: 60rpx;
  font-size: 24rpx;
}
.chat-bubble {
  margin-left: 16rpx;
  background: #f6f7f9;
  border-radius: 12rpx;
  padding: 10rpx 18rpx;
  max-width: 520rpx;
}
.chat-bubble.img-bubble {
  background: transparent;
  padding: 0;
}
.ride-msg-img {
  width: 300rpx;
  max-width: 300rpx;
  border-radius: 12rpx;
  margin-top: 6rpx;
}
.chat-input {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.chat-input input {
  background: #f6f7f9;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
}
.send-btn {
  margin-left: 16rpx;
  padding: 8rpx 28rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.chat-hint {
  text-align: center;
  padding: 16rpx 0 8rpx;
}
.share-row {
  padding: 8rpx 0 48rpx;
}

/* ---- 轮询卡 ---- */
.poll-card {
  margin-top: 20rpx;
  border: 1rpx solid #07c160;
  background: #f7fdf9;
}
.poll-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.poll-btns {
  margin-top: 20rpx;
}
.poll-tag {
  margin: 20rpx 24rpx 0;
}
.poll-tag .tag {
  padding: 6rpx 18rpx;
}

/* ---- 其它 ---- */
.back-btn {
  margin: 40rpx 80rpx 0;
}
.act-row {
  margin-top: 16rpx;
}
/* 主动作：我到了（大主按钮独占一行）/ 已签到态 */
.act-main {
  display: block;
  width: 100%;
  box-sizing: border-box;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 14rpx;
}
.act-main-done {
  background: #e8f9ef;
  color: #07c160;
  text-align: center;
}
/* 次要动作：退出/解散 小字链接（低频、低调） */
.act-sub {
  justify-content: center;
  margin-top: 20rpx;
  padding-bottom: 8rpx;
}
.act-link {
  color: #fa5151;
  font-size: 24rpx;
  padding: 12rpx 30rpx;
}
.chat-empty {
  padding: 20rpx 0 4rpx;
  text-align: center;
}
.locked-chat {
  padding: 32rpx 16rpx 16rpx;
  text-align: center;
}
.joined-chat {
  padding: 28rpx 16rpx 20rpx;
  text-align: center;
}
.joined-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}
.joined-tip {
  margin-bottom: 20rpx;
}
.locked-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.locked-tip {
  margin-bottom: 24rpx;
}
.join-chat-btn {
  width: 360rpx;
  margin: 0 auto;
}
.join-wrap {
  text-align: center;
  padding: 4rpx 0 8rpx;
}
.join-center {
  width: 420rpx;
  margin: 0 auto;
}

/* ---- 基本规则表 ---- */
.rules-card {
  margin-top: 20rpx;
}
.rules-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.rules-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
  font-size: 26rpx;
}
.rules-row:last-child {
  border-bottom: none;
}
.rules-head {
  font-size: 22rpx;
  color: #8a9099;
}
.rules-row .t {
  width: 220rpx;
  flex-shrink: 0;
  font-weight: 600;
  color: #07a55a;
}
.rules-row .d {
  flex: 1;
  color: #4e545c;
  line-height: 1.5;
}

/* ---- 聊天室分区 ---- */
.chat-head {
  display: flex;
  align-items: baseline;
  padding: 4rpx 0 0;
}
.chat-head-sub {
  margin-left: 16rpx;
}
.chat-divider {
  margin: 16rpx 0 4rpx;
}
.msg-area {
  padding: 4rpx 0 8rpx;
}

/* ---- 页脚说明 ---- */
.foot-note {
  padding: 8rpx 48rpx 48rpx;
  text-align: center;
  color: #a5abb3;
  font-size: 22rpx;
  line-height: 1.6;
}

/* ---- 平台 AA 提示（常驻入口 → 如何AA 教程页） ---- */
.aa-tip {
  margin: 0 24rpx 20rpx;
  padding: 20rpx 24rpx;
  background: #fff7e6;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.aa-tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #8a5a00;
  line-height: 1.6;
  padding-right: 16rpx;
}
.aa-tip-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #ff9f0a;
  font-weight: 600;
}

/* ---- 成员行内操作 / 浮层 ---- */
.member-row:active {
  background: #f7f8fa;
}
.member-acts {
  flex-shrink: 0;
}
.mini-link {
  font-size: 22rpx;
  color: #07a55a;
  padding: 8rpx 0 8rpx 24rpx;
}
.mini-link.danger {
  color: #fa5151;
}

/* 已结束提示条 */
.done-tip {
  background: #f0f1f3;
  border-radius: 12rpx;
  padding: 26rpx 40rpx;
  margin: 4rpx 24rpx 12rpx;
  text-align: center;
}
.done-title {
  font-size: 28rpx;
  color: #4e545c;
  font-weight: 600;
  margin-bottom: 4rpx;
}
