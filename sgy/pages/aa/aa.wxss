/* pages/aa/aa.wxss —— 如何 AA（线下付款） */
.intro {
  margin-top: 20rpx;
}
.intro-title {
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.method {
  padding: 24rpx;
}
.method-head {
  margin-bottom: 8rpx;
}
.method-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-left: 12rpx;
}
.method-desc {
  font-size: 26rpx;
  color: #4e545c;
  line-height: 1.6;
  margin-bottom: 12rpx;
}
.method-step {
  font-size: 25rpx;
  color: #4e545c;
  line-height: 1.7;
  padding: 4rpx 0;
  padding-left: 12rpx;
  border-left: 4rpx solid #e8f9ef;
  margin-bottom: 6rpx;
}
.method-warn {
  font-size: 24rpx;
  color: #ff9f0a;
  line-height: 1.6;
  margin: 12rpx 0 16rpx;
  background: #fff7e6;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
}

/* 图位：作者配图后替换成 <image>（imgFace/imgCode/imgGroup 非空时渲染） */
.img-slot {
  width: 100%;
  border-radius: 12rpx;
  margin-top: 12rpx;
}
.img-placeholder {
  border: 2rpx dashed #d8dee6;
  border-radius: 12rpx;
  padding: 48rpx 24rpx;
  margin-top: 12rpx;
  text-align: center;
  color: #a5abb3;
  font-size: 24rpx;
}

.foot-note {
  padding: 8rpx 48rpx 48rpx;
  text-align: center;
  color: #a5abb3;
  font-size: 22rpx;
  line-height: 1.6;
}
