<!--pages/admin/admin.wxml-->
<view class="page">
  <!-- 待复核举报 -->
  <view class="section">待复核举报（{{reports.length}}）</view>
  <view wx:if="{{reports.length}}" class="rep-list">
    <view wx:for="{{reports}}" wx:key="_id" class="card no-margin rep-card">
      <view class="row-between">
        <text class="strong">{{item.targetName}}</text>
        <text class="tag tag-red">{{item.kindLabel}}</text>
      </view>
      <view class="small muted rep-meta">举报人：{{item.byName}}{{item.rideLabel ? ' · ' + item.rideLabel : ''}}</view>
      <view wx:if="{{item.note}}" class="small muted rep-note">{{item.note}}</view>
      <view class="row rep-acts">
        <button class="btn btn-danger-ghost act-half" data-id="{{item._id}}" data-kind="{{item.kindLabel}}"
          data-name="{{item.targetName}}" bindtap="onResolve">坐实扣分</button>
        <button class="btn btn-ghost act-half" data-id="{{item._id}}" bindtap="onDismiss">驳回</button>
      </view>
    </view>
  </view>
  <view wx:else class="card no-margin empty-sm">暂无待复核举报 🎉</view>

  <!-- 代发种子局 -->
  <view class="section">代发种子局</view>
  <view class="card no-margin">
    <view class="field">
      <view class="field-label">线路</view>
      <picker class="flex-1" mode="selector" range="{{routeOptions}}" range-key="label" value="{{routeIndex}}" bindchange="onPickRoute">
        <view class="field-value">{{routeOptions[routeIndex].label}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">日期</view>
      <picker class="flex-1" mode="date" value="{{date}}" start="{{dateStart}}" bindchange="onPickDate">
        <view class="field-value">{{date}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">时间</view>
      <picker class="flex-1" mode="time" value="{{time}}" start="{{timeStart}}" bindchange="onPickTime">
        <view class="field-value time-big">{{time}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">人数上限</view>
      <view class="row cap-group">
        <text wx:for="{{capacityRange}}" wx:key="*this" class="chip cap-chip {{capacity === item ? 'active' : ''}}"
          data-cap="{{item}}" bindtap="onCapTap">{{item}} 人</text>
      </view>
    </view>
  </view>
  <button class="btn btn-primary btn-block" bindtap="onSeed">以我名义代发（作种子局）</button>
</view>
