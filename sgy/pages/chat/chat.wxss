/* pages/chat/chat.wxss */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background: #ededed;
}

/* 空态/加载 */
.empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #8a9099;
  padding: 0 48rpx;
}
.empty-btn {
  width: 320rpx;
  margin-top: 40rpx;
}

/* 顶栏：当前队伍 */
.room-bar {
  margin: 20rpx 24rpx 12rpx;
  padding: 20rpx 24rpx;
  flex-shrink: 0;
}
.room-title {
  margin-bottom: 6rpx;
  padding-right: 16rpx;
}
.room-time {
  font-size: 24rpx;
  color: #8a9099;
  margin-bottom: 4rpx;
}
.room-route {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
  word-break: break-all;
}
.room-switch {
  white-space: nowrap;
  margin: 0 24rpx 4rpx;
  flex-shrink: 0;
}
.room-chip {
  display: inline-flex;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid #e6e8eb;
  color: #4e545c;
  font-size: 24rpx;
  margin-right: 14rpx;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}
.room-chip.active {
  background: #e8f9ef;
  color: #07c160;
  border-color: #07c160;
  font-weight: 600;
}
.room-chip.done {
  color: #a5abb3;
  background: #f7f8fa;
  border-color: #f0f1f3;
}
.switch-hint {
  margin: 4rpx 24rpx 8rpx;
  flex-shrink: 0;
}

/* 消息滚动区：占满剩余空间（微信聊天灰底，与下方白色导航区分） */
.msg-scroll {
  flex: 1;
  min-height: 0;
  background: #ededed;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.chat-empty {
  padding: 60rpx 0;
  text-align: center;
}

/* 消息行 / 气泡（微信式左右分栏，名字/时间在气泡外） */
.chat-row {
  display: flex;
  padding: 14rpx 0;
}
.chat-row.mine {
  flex-direction: row-reverse;
}
.chat-avatar {
  width: 60rpx;
  height: 60rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}
.chat-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
  max-width: 600rpx;
}
.chat-meta {
  font-size: 20rpx;
  color: #a5abb3;
  margin: 0 0 4rpx 16rpx;
}
.chat-meta.right {
  text-align: right;
  margin: 0 16rpx 4rpx 0;
}
.chat-bubble {
  padding: 12rpx 18rpx;
  border-radius: 12rpx;
  max-width: 560rpx;
  font-size: 27rpx;
  align-self: flex-start;
  word-break: break-all;
}
.chat-row:not(.mine) .chat-bubble {
  background: #f2f3f5; /* 别人：灰底 */
  margin-left: 16rpx;
}
.chat-row.mine .chat-bubble {
  background: #95ec69; /* 我：绿底 */
  margin-right: 16rpx;
  align-self: flex-end;
}
.chat-row .img-bubble {
  background: transparent !important;
  border: none;
  padding: 0;
  margin: 0;
  box-shadow: none;
}
.chat-row .img-bubble .msg-img {
  width: 320rpx;
  max-width: 320rpx;
  border-radius: 12rpx;
  display: block;
}
.bubble-text {
  word-break: break-all;
}
.img-bubble {
  background: transparent;
  padding: 0;
}
.msg-img {
  width: 320rpx;
  max-width: 320rpx;
  border-radius: 12rpx;
  margin-top: 6rpx;
}

/* 底部输入条 */
.chat-input {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e6e8eb;
}
.img-btn {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f0f1f3;
  color: #07c160;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  padding: 0;
}
.img-btn.disabled {
  opacity: 0.4;
}
.chat-input-field {
  flex: 1;
  min-width: 0;
  background: #f6f7f9;
  border-radius: 999rpx;
  padding: 0 24rpx;
  height: 64rpx;
  font-size: 27rpx;
  line-height: 64rpx;
}
.send-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 0 30rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: #07c160;
  color: #fff;
  font-size: 27rpx;
  border-radius: 999rpx;
}

/* ---- 聊天室公约（半屏面板，分条排版；遮罩/面板/头部/关闭/确定 用 app.wxss sheet-* 共用） ---- */
.cr-title {
  font-size: 34rpx;
  font-weight: 700;
}
.cr-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}
.cr-item:last-child {
  border-bottom: none;
}
.cr-item-t {
  font-size: 27rpx;
  font-weight: 600;
  color: #07a55a;
  margin-bottom: 4rpx;
}
.cr-item-d {
  font-size: 25rpx;
  color: #4e545c;
  line-height: 1.6;
}

